{
  "swagger": "2.0",
  "info": {
    "title": "Google Drive Upload API",
    "version": "v3"
  },
  "host": "www.googleapis.com",
  "basePath": "/upload/drive/v3",
  "schemes": ["https"],
  "paths": {
    "/files": {
      "post": {
        "summary": "Upload File",
        "operationId": "uploadFile",
        "consumes": ["multipart/form-data"],
        "parameters": [
          { "name": "uploadType", "in": "query", "type": "string", "required": true, "default": "multipart" },
          { "name": "file", "in": "formData", "type": "file", "required": true, "description": "The file attachment control from K2" }
        ],
        "responses": {
          "200": { "description": "Success" }
        }
      }
    }
  }
}